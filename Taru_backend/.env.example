## Backend Environment Variables
## Copy this file to .env and fill in the values

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (replace with your own)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Taru?retryWrites=true&w=majority

# JWT secret — use a long random string in production
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Frontend URL — set this to your deployed Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# TURN Server (Metered.ca)
TURN_URL=turn:your_domain.relay.metered.ca:443
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential
